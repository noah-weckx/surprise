{
  "name": "personal-archive",
  "version": "1.0.0",
  "private": true,
  "description": "A warm, static, offline-friendly personal media archive.",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:js && npm run lint:py",
    "lint:html": "htmlhint --ignore \"venv/**,node_modules/**\" \"**/*.html\"",
    "lint:js": "eslint \"src/js/**/*.js\"",
    "lint:py": "python -m flake8 --max-line-length=100 --exclude=venv,node_modules scripts content",
    "build:css": "tailwindcss -i ./src/css/styles.css -o ./assets/css/styles.css --minify",
    "build": "npm run build:css && python scripts/generate_manifest.py",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "htmlhint": "^1.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "tailwindcss": "^3.4.17"
  },
  "lint-staged": {
    "*.html": "npx htmlhint",
    "*.js": "npx eslint --fix",
    "*.py": "python -m flake8 --max-line-length=100 --exclude=venv,node_modules"
  }
}
